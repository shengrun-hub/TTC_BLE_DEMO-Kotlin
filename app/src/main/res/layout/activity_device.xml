<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:padding="6dp">

    <com.ttcble.leui.widget.LogView
        android:id="@+id/device_log_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_gray"
        android:padding="6dp" />

    <EditText
        android:id="@+id/device_edt_tx"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/bg_white"
        android:gravity="start|top"
        android:padding="6dp"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical|end"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/device_tv_bytes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical" />

        <CheckBox
            android:id="@+id/device_cbox_hex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="HEX"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/device_cbox_encrypt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/encrypt"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/device_btn_send"
        style="@style/BtnStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="6dp"
        android:text="@string/connected_send"
        android:textSize="16sp" />
</LinearLayout>
